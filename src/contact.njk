---
layout: layouts/page.njk
title: Contact
permalink: /contact/
---
<div class="wrapper">
  <h1>Contact</h1>
</div>
<dl class="contact-details wrapper">
  {% if business.phone %}
  <dt>Phone</dt>
  <dd><a href="tel:{{ business.phone }}">{{ business.phone }}</a></dd>
  {% endif %}
  {% if business.email %}
  <dt>Email</dt>
  <dd><a href="mailto:{{ business.email }}">{{ business.email }}</a></dd>
  {% endif %}
  {% if business.address %}
  <dt>Address</dt>
  <dd>{{ business.address }}</dd>
  {% endif %}
</dl>

